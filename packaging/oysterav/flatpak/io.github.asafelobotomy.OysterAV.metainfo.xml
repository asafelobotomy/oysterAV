<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.asafelobotomy.OysterAV</id>
  <name>oysterAV</name>
  <summary>Linux security orchestrator</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.asafelobotomy">
    <name>oysterAV contributors</name>
  </developer>
  <url type="homepage">https://github.com/asafelobotomy/oysterAV</url>
  <url type="bugtracker">https://github.com/asafelobotomy/oysterAV/issues</url>
  <description>
    <p>
      oysterAV orchestrates mature Linux security tools (ClamAV, rkhunter, Lynis, and more)
      via a CLI-first backend and a thin GTK4 GUI client.
    </p>
    <p>
      Important: this Flatpak is not sandboxed. It is granted full host filesystem access
      and permission to run commands on the host (via flatpak-spawn --host) so it can drive
      host scanners and Polkit elevation. Treat it like a native install, not a confinement
      boundary for untrusted files.
    </p>
    <p>
      Privileged operations require a host-installed package (AUR or GitHub .deb/.rpm) that
      provides the root-owned oyst-helper and Polkit policy. A Flatpak-only install cannot
      complete helper setup alone.
    </p>
  </description>
  <launchable type="desktop-id">io.github.asafelobotomy.OysterAV.desktop</launchable>
  <icon type="stock">oysterav</icon>
  <categories>
    <category>System</category>
    <category>Security</category>
  </categories>
