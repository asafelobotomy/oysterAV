<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.asafelobotomy.OysterAV</id>
  <name>oysterAV</name>
  <summary>Linux security orchestrator</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.asafelobotomy">
    <name>oysterAV contributors</name>
  </developer>
  <url type="homepage">https://github.com/asafelobotomy/oysterAV</url>
  <url type="bugtracker">https://github.com/asafelobotomy/oysterAV/issues</url>
  <description>
    <p>
      oysterAV orchestrates mature Linux security tools (ClamAV, rkhunter, Lynis, and more)
      via a CLI-first backend and a thin GTK4 GUI client. The GUI talks only to OystClient
      over local JSON-RPC — it never runs security binaries directly.
    </p>
    <p>
      Flatpak installs the GUI client with host filesystem access so oysterAV can reach
      host scanners and elevate via flatpak-spawn. Privileged operations require a
      host-installed package (AUR, COPR, or GitHub .deb/.rpm) that provides the root-owned
      oyst-helper and Polkit policy. A Flatpak-only install cannot complete helper setup alone.
    </p>
  </description>
  <launchable type="desktop-id">io.github.asafelobotomy.OysterAV.desktop</launchable>
  <icon type="stock">oysterav</icon>
  <categories>
    <category>System</category>
    <category>Security</category>
  </categories>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/asafelobotomy/oysterAV/main/docs/assets/screenshots/dashboard.png</image>
      <caption>Dashboard posture overview</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/asafelobotomy/oysterAV/main/docs/assets/screenshots/scan.png</image>
      <caption>Scan profiles and pack cards</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/asafelobotomy/oysterAV/main/docs/assets/screenshots/settings.png</image>
      <caption>Settings and maintenance</caption>
    </screenshot>
  </screenshots>
  <provides>
