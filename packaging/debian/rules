#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYBUILD_NAME = oysterav

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# desktop/polkit/icons come from debian/oysterav.install
	install -d debian/oysterav/usr/bin
	ln -sf ../lib/oysterav/oyst-helper debian/oysterav/usr/bin/oyst-helper

# dh_install cannot rename files, so install the helper under its final name.
execute_after_dh_install:
	install -Dm755 debian/oyst-helper.in debian/oysterav/usr/lib/oysterav/oyst-helper
