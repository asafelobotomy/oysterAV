{
  "path": "/home/user/.config/oysterav/config.toml",
  "values": {
    "scan.profile": "quick",
    "scan.backend": "auto",
    "scan.clamav_profile": "full",
    "scan.max_filesize": "25M",
    "scan.max_recursion": 8,
    "scan.max_files": 10000,
    "scan.apply_limits_to": "quick",
    "scan.exclude_dirs": [],
    "clamav.ignore_sigs": [],
    "quarantine.auto": false,
    "quarantine.secure_wipe": false,
    "clamonacc.enabled": false,
    "clamonacc.prevention": false,
    "clamonacc.paths": [
      "~/Downloads",
      "~/Desktop"
    ],
    "clamonacc.exclude_paths": [
      "~/.cache",
      "~/.local/share/Trash"
    ],
    "maldet_monitor.enabled": false,
    "runtime.mode": "full",
    "runtime.auto_update_signatures": true,
    "fangfrisch.providers": [
      "sanesecurity",
      "urlhaus"
    ],
    "rkhunter.skip_keypress": true,
    "rkhunter.disable_tests": [
      "suspscan"
    ],
    "lynis.quick": true,
    "ui.security_news": true,
    "ui.security_news_max_age_days": "14",
    "ui.run_at_startup": false,
    "ui.start_minimized": false,
    "ui.minimize_to_tray": false,
    "ui.theme": "gruvbox-dark-hard"
  },
  "schema": [
    {
      "key": "scan.profile",
      "group": "Scanning",
      "kind": "choice",
      "choices": [
        "quick",
        "full",
        "integrity",
        "suite"
      ],
      "label": "Default scan",
      "help": "What a scan with no profile runs."
    },
    {
      "key": "scan.backend",
      "group": "Scanning",
      "kind": "choice",
      "choices": [
        "auto",
        "clamd",
        "clamscan"
      ],
      "label": "ClamAV engine",
      "help": "clamd is faster when its daemon runs; clamscan always works."
    },
    {
      "key": "scan.clamav_profile",
      "group": "Scanning",
      "kind": "choice",
      "choices": [
        "full",
        "linux-only"
      ],
      "label": "File types",
      "help": "Linux-only skips Windows executables."
    },
    {
      "key": "scan.max_filesize",
      "group": "Scanning",
      "kind": "text",
      "label": "Biggest file scanned",
      "help": "Like 25M or 100K."
    },
    {
      "key": "scan.max_recursion",
      "group": "Scanning",
      "kind": "int",
      "min": 1,
      "label": "Archive depth",
      "help": "How deep to look inside archives in archives."
    },
    {
      "key": "scan.max_files",
      "group": "Scanning",
      "kind": "int",
      "min": 1,
      "label": "Files per archive",
      "help": "Stops a zip bomb from running forever."
    },
    {
      "key": "scan.apply_limits_to",
      "group": "Scanning",
      "kind": "choice",
      "choices": [
        "quick",
        "all"
      ],
      "label": "Apply these limits to",
      "help": "Only quick scans, or every scan."
    },
    {
      "key": "scan.exclude_dirs",
      "group": "Scanning",
      "kind": "list",
      "path": true,
      "label": "Folders to skip",
      "help": "Absolute paths, or starting with ~/."
    },
    {
      "key": "clamav.ignore_sigs",
      "group": "Scanning",
      "kind": "list",
      "label": "Ignored signatures",
      "help": "Names of signatures that give false alarms."
    },
    {
      "key": "quarantine.auto",
      "group": "Quarantine",
      "kind": "bool",
      "label": "Quarantine what scans find",
      "help": "Move infected files to the vault automatically."
    },
    {
      "key": "quarantine.secure_wipe",
      "group": "Quarantine",
      "kind": "bool",
      "label": "Overwrite deleted files",
      "help": "Best effort: an SSD may keep the old blocks."
    },
    {
      "key": "clamonacc.enabled",
      "group": "Protection",
      "kind": "bool",
      "label": "Scan files as they are opened",
      "help": "ClamAV on-access, for the folders below."
    },
    {
      "key": "clamonacc.prevention",
      "group": "Protection",
      "kind": "bool",
      "label": "Block infected files",
      "help": "Refuse to open a file that is found infected."
    },
    {
      "key": "clamonacc.paths",
      "group": "Protection",
      "kind": "list",
      "path": true,
      "label": "Watched folders",
      "help": ""
    },
    {
      "key": "clamonacc.exclude_paths",
      "group": "Protection",
      "kind": "list",
      "path": true,
      "label": "Never watched",
      "help": ""
    },
    {
      "key": "maldet_monitor.enabled",
      "group": "Protection",
      "kind": "bool",
      "label": "Linux Malware Detect monitor",
      "help": "Watches for new files with maldet."
    },
    {
      "key": "runtime.mode",
      "group": "Updates",
      "kind": "choice",
      "choices": [
        "full",
        "lite"
      ],
      "label": "Where scanners come from",
      "help": "Full keeps its own copies; lite uses your distribution's packages."
    },
    {
      "key": "runtime.auto_update_signatures",
      "group": "Updates",
      "kind": "bool",
      "label": "Update signatures automatically",
      "help": "Full mode only."
    },
    {
      "key": "fangfrisch.providers",
      "group": "Updates",
      "kind": "list",
      "choices": [
        "sanesecurity",
        "urlhaus",
        "interserver",
        "malwarepatrol",
        "securiteInfo"
      ],
      "label": "Extra signature feeds",
      "help": "Unofficial signatures, refreshed with fangfrisch."
    },
    {
      "key": "rkhunter.skip_keypress",
      "group": "System scans",
      "kind": "bool",
      "label": "rkhunter without prompts",
      "help": ""
    },
    {
      "key": "rkhunter.disable_tests",
      "group": "System scans",
      "kind": "list",
      "label": "rkhunter tests to skip",
      "help": "Test names, like suspscan."
    },
    {
      "key": "lynis.quick",
      "group": "System scans",
      "kind": "bool",
      "label": "Quick Lynis audit",
      "help": "Skips the pauses between tests."
    },
    {
      "key": "ui.security_news",
      "group": "Security news",
      "kind": "bool",
      "label": "Show security news",
      "help": "Advisories from your distribution and others."
    },
    {
      "key": "ui.security_news_max_age_days",
      "group": "Security news",
      "kind": "choice",
      "choices": [
        "7",
        "14",
        "30"
      ],
      "label": "News newer than (days)",
      "help": ""
    },
    {
      "key": "ui.run_at_startup",
      "group": "App",
      "kind": "bool",
      "label": "Start oysterAV at login",
      "help": ""
    },
    {
      "key": "ui.start_minimized",
      "group": "App",
      "kind": "bool",
      "label": "Start minimised",
      "help": ""
    },
    {
      "key": "ui.minimize_to_tray",
      "group": "App",
      "kind": "bool",
      "label": "Keep running in the tray",
      "help": ""
    },
    {
      "key": "ui.theme",
      "group": "App",
      "kind": "choice",
      "choices": [
        "system",
        "gruvbox-dark-hard",
        "gruvbox-dark-medium",
        "gruvbox-dark-soft",
        "gruvbox-light-hard",
        "gruvbox-light-medium",
        "gruvbox-light-soft"
      ],
      "label": "Colour theme",
      "help": "The oysterAV window only; uQ Settings follows uQ."
    }
  ]
}
